# Paste into Dokploy → Environment (not committed).
# Secrets are injected via env_file. For in-stack Postgres, POSTGRES_PASSWORD is
# the source of truth (API/migrate rebuild DATABASE_URL from it). Keep both in
# sync in this file so humans reading the env are not misled.

NODE_ENV=production
COMPOSE_PROJECT_NAME=electromon-production

POSTGRES_USER=electromon
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=electromon
DATABASE_URL=postgresql://electromon:CHANGE_ME@postgres:5432/electromon?schema=public

REDIS_URL=redis://redis:6379

RABBITMQ_USER=electromon
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_DEFAULT_USER=electromon
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_URL=amqp://electromon:CHANGE_ME@rabbitmq:5672

S3_ACCESS_KEY=electromon
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=electromon
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=electromon
MINIO_ROOT_PASSWORD=CHANGE_ME

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

METRICS_TOKEN=CHANGE_ME
API_PORT=3002
API_PUBLIC_URL=https://api.electromon.ng
CORS_ORIGIN=https://app.electromon.ng
LOG_LEVEL=info
RUN_SEED=false

# Production APC seed (runs after migrate on every deploy; idempotent upserts).
# Min 12 chars. Do not use ChangeMe123!, password, Password123!, admin123456, danmodi123!
SEED_ADMIN_PASSWORD=CHANGE_ME_min_12_chars
SEED_ADMIN_EMAIL=director@danmodi.ng
SEED_ADMIN_PHONE=+2348000000001
