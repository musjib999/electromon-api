# =============================================================================
# PRODUCTION — full Docker stack (DigitalOcean / VPS)
# Copy to project root:  cp infra/env/production.env.example .env
# NEVER commit this file with real secrets.
# =============================================================================

NODE_ENV=production
COMPOSE_PROJECT_NAME=electromon-production
COMPOSE_NETWORK_NAME=electromon-production

# PostgreSQL — use strong passwords; prefer managed DB in production
POSTGRES_USER=electromon
POSTGRES_PASSWORD=CHANGE_ME_production_db_password
POSTGRES_DB=electromon

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_USER=electromon
RABBITMQ_PASSWORD=CHANGE_ME_production_rabbitmq_password
RABBITMQ_URL=amqp://electromon:CHANGE_ME_production_rabbitmq_password@rabbitmq:5672

# S3 — local MinIO OR DigitalOcean Spaces
S3_ACCESS_KEY=CHANGE_ME_spaces_access_key
S3_SECRET_KEY=CHANGE_ME_spaces_secret_key
S3_BUCKET=electromon-production
S3_REGION=nyc3
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# External managed PostgreSQL (required for make infra-prod-external-up)
# DATABASE_URL=postgresql://user:pass@host:25060/electromon?sslmode=require

# JWT — openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_production_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_production_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Metrics scrape token — openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_production_metrics_token

# API (internal; public via Caddy)
API_PORT=3001
CORS_ORIGIN=https://app.electromon.ng

# Caddy edge
WEB_HOST=app.electromon.ng
API_HOST=api.electromon.ng
ACME_EMAIL=ops@electromon.ng
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_production_grafana_password
GRAFANA_PORT=3030
GRAFANA_ROOT_URL=http://127.0.0.1:3030
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_SLACK_CHANNEL=#electromon-alerts

# Web (build args for electromon-web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.electromon.ng
NEXT_PUBLIC_WS_URL=https://api.electromon.ng

# Never seed production with the demo seed (fake results / demo users)
RUN_SEED=false

# Production APC seed — migrate runs this after prisma migrate deploy when set.
# Idempotent (upserts). Min 12 chars; do not use demo defaults.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=director@danmodi.ng
SEED_ADMIN_PHONE=+2348000000001
# SEED_CANDIDATE_EMAIL=
# SEED_CANDIDATE_PHONE=
# SEED_STATE_OFFICER_EMAIL=
# SEED_STATE_OFFICER_PHONE=
